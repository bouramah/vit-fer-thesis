# Nom de domaine public (doit pointer vers l'IP du VPS)
DOMAIN=emovision.example.org
# Mot de passe de la page /admin (contributions consenties). Choisir un mot de passe long.
ADMIN_PASSWORD=
# Adresse affichée aux visiteurs pour les demandes de retrait (facultatif)
CONTACT_EMAIL=
# Nombre de threads PyTorch (= nombre de vCPU du VPS)
EMOVISION_THREADS=4
